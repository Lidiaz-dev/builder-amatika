# Copier en .env.local pour brancher Firebase en local (sinon : mode local, stockage navigateur).
# Valeurs dans la console Firebase : Paramètres du projet > Vos applications > Application Web.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=xxxxxxxx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=xxxxxxxx
VITE_FIREBASE_APP_ID=

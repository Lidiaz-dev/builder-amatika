rules_version = '2';

// Règles de sécurité Firestore : à coller dans la console Firebase
// (Firestore Database > Règles), puis « Publier ».
// - Chaque compte ne voit et ne modifie que ses propres bandes.
// - Seul l'organisateur (adresse vérifiée) crée les campagnes, y inscrit les joueurs
//   et gère les journées ; il peut consulter les bandes inscrites à une campagne.
// - Un joueur inscrit voit la campagne, ses participants et leurs bandes (consultation),
//   rejoint les journées et rend son rapport de fin de nuit.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isAdmin() { return verified() && myEmail() == 'lidiaz.video@gmail.com'; }
    function campaign(cid) { return get(/databases/$(database)/documents/campaigns/$(cid)).data; }
    function isPlayer(cid) { return verified() && myEmail() in campaign(cid).emails; }
    // La liste n'a changé que par l'ajout ou le retrait de l'email du joueur connecté.
    function onlyMe(after, before) {
      return after.toSet() == before.toSet()
        || after.toSet() == before.toSet().union([myEmail()].toSet())
        || after.toSet() == before.toSet().difference([myEmail()].toSet());
    }

    // Profil de chaque compte : pseudo (affiché à la place de l'email) et email.
    match /users/{uid} {
      // L'organisateur lit la liste des comptes pour ajouter des joueurs (pseudo + email).
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() >= 2
        && request.resource.data.pseudo.size() <= 24
        && request.resource.data.get('email', myEmail()) == myEmail();
    }

    match /crews/{crewId} {
      // Une bande inscrite à une campagne est consultable par l'organisateur et par les joueurs de cette campagne.
      allow read: if signedIn() && (resource.data.uid == request.auth.uid
        || (resource.data.get('campaignId', null) != null
          && (isAdmin() || isPlayer(resource.data.campaignId))));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
    }

    match /campaigns/{cid} {
      allow read: if isAdmin() || (verified() && myEmail() in resource.data.emails);
      allow write: if isAdmin();

      match /entries/{email} {
        // Les joueurs voient qui participe à la campagne (pseudo, bande, couronne).
        allow read: if isAdmin() || isPlayer(cid);
        allow create, delete: if isAdmin();
        allow update: if isAdmin()
          || (isPlayer(cid) && email == myEmail() && request.resource.data.email == email);
      }

      // Envois entre joueurs et du maître de campagne : créés par l'expéditeur, reçus par le
      // destinataire dès qu'il ouvre sa bande (il ne peut que les marquer comme reçus).
      match /gifts/{gid} {
        allow read: if isAdmin() || (verified() && (resource.data.to == myEmail() || resource.data.from == myEmail()));
        allow create: if (isPlayer(cid) || isAdmin())
          && request.resource.data.from == myEmail()
          && request.resource.data.to in campaign(cid).emails
          // Pas d'envoi à soi-même, sauf le maître de campagne (corrections et tests sur sa propre bande).
          && (request.resource.data.to != myEmail() || isAdmin())
          && request.resource.data.claimed == false
          // Seul le maître de campagne peut marquer un envoi « admin » (reçu tout de suite).
          && (request.resource.data.get('admin', false) == false || isAdmin())
          && (request.resource.data.get('remove', []).size() == 0 || isAdmin())
          && (request.resource.data.get('xp', []).size() == 0 || isAdmin())
          && (request.resource.data.get('spells', []).size() == 0 || isAdmin());
        allow update: if verified() && resource.data.to == myEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed'])
          && request.resource.data.claimed == true;
        allow delete: if isAdmin();
      }

      match /days/{dayId} {
        allow read: if isAdmin() || isPlayer(cid);
        allow create, delete: if isAdmin();
        // Pendant la préparation, un joueur peut rejoindre ou quitter la journée et valider (ou rouvrir)
        // sa préparation : seulement pour lui-même, et il ne peut être prêt que s'il participe.
        allow update: if isAdmin()
          || (isPlayer(cid)
            && resource.data.status == 'preparation'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'ready'])
            && onlyMe(request.resource.data.participants, resource.data.participants)
            && onlyMe(request.resource.data.get('ready', []), resource.data.get('ready', []))
            && (!(myEmail() in request.resource.data.get('ready', [])) || myEmail() in request.resource.data.participants));

        match /sheets/{email} {
          // Les rapports de fin de nuit sont consultables par tous les joueurs de la campagne (suivi).
          allow read: if isAdmin() || isPlayer(cid);
          allow delete: if isAdmin();
          allow create, update: if isPlayer(cid)
            && email == myEmail()
            && request.resource.data.email == email
            && get(/databases/$(database)/documents/campaigns/$(cid)/days/$(dayId)).data.status == 'nuit'
            && email in get(/databases/$(database)/documents/campaigns/$(cid)/days/$(dayId)).data.participants;
        }
      }
    }
  }
}
